# vectorizer-mcp (hosted HTTP variant) — built from ./mcp, runs only on loopback.
FROM node:22-alpine
WORKDIR /srv/mcp
COPY mcp/package.json mcp/package-lock.json* ./
RUN npm ci --omit=dev 2>/dev/null || npm install --omit=dev
COPY mcp/src ./src
COPY mcp/tsconfig.json ./
RUN npx tsc
ENV NODE_ENV=production MCP_HTTP_PORT=8093 MCP_HTTP_HOST=127.0.0.1
EXPOSE 8093
CMD ["node", "dist/http.js"]
