# Vectorizer Configuration
# Copy to .env and adjust values

# Server port
PORT=8091
GRPC_PORT=50051

# API key for authentication (optional, set to "" to disable)
DEFAULT_API_KEY=your-secret-api-key-here
# Fail-closed startup (P0-2): the server REFUSES to start with no auth
# material unless you explicitly opt into local-dev mode. For loopback-only
# local dev with no key, set VECTORIZER_ALLOW_OPEN=true (never expose that).
# VECTORIZER_ALLOW_OPEN=false
# JWT auth : set AUTH_USE_AUTH=true and AUTH_JWT_SECRET to enable workspace-scoped JWT
# AUTH_USE_AUTH=false
# AUTH_JWT_SECRET=

# ChromaDB connection
CHROMA_HOST=localhost
CHROMA_PORT=8100
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# Embedding provider: "lm-studio" or "openai-compatible"
# Canonical default: 768d Nomic (cheap, CPU-friendly). For the 1536d Qwen
# opt-in (parity), use openai-compatible with vLLM TEI — see below.
EMBED_PROVIDER=openai-compatible
EMBED_MODEL=text-embedding-nomic-embed-text-v2
EMBED_DIMENSIONS=768

# LM Studio (local) - for embeddings & LLM when using LM Studio
LM_STUDIO_URL=http://host.docker.internal:1234/v1
LM_STUDIO_API_KEY=lm-studio
LLM_API_KEY=lm-studio

# OpenAI-compatible embedding endpoint (vLLM TEI for Qwen3)
OAI_COMPATIBLE_URL=http://host.docker.internal:1234/v1
OAI_API_KEY=lm-studio
# For CPU dev without GPU, defaults already are: EMBED_MODEL=nomic-embed-text,
# EMBED_DIMENSIONS=768, OAI_COMPATIBLE_URL=http://localhost:1234/v1

# Embedding model name — canonical default 768d Nomic at EMBED_DIMENSIONS=768.
# 1536d Qwen opt-in: EMBED_MODEL=Qwen/Qwen3-Embedding-4B + EMBED_DIMENSIONS=1536
# (requires the qwen-embed vLLM profile in docker-compose.yml).
EMBED_MODEL=text-embedding-nomic-embed-text-v2

# For Qwen self-host via vLLM (optional)
# HF_TOKEN=hf_...
# QWEN_PORT=8001

# TTL auto-cleanup (0=disabled)
# TTL_HOURS=0

# ─── Server-deploy only (private .env, never commit) ──────────────
# AI_DATA_DIR=<local-vault-mirror>    # local compose read-only vault mount
# TAILNET_MCP_IP=<tailnet-server-ip>  # required by ./up.sh verify
# APP_DIR=<server-app-dir>            # required by ./up.sh verify
# STAGE_DIR=<server-stage-dir>        # required by ./up.sh verify
# VAULT_DATA_DIR=<server-data-dir>    # required by docker-compose.server.yml
# GRAPH_PATH=<server-graph-path>       # required by docker-compose.server.yml
# BACKUP_ROOT=$HOME/backups            # ops-cron backup base (default shown)

# ─── Code indexing jail (F5) ───────────────────────────────────────
# POST /code/index only indexes paths under these comma-separated roots
# (symlinks escaping them are skipped). Defaults suit the containers.
# CODE_INDEX_ROOT=/data/ai,/data/repo

# ─── LLM Brain (optional) ──────────────────────────────
# Set LLM_ENABLED=true to enable summarization & Q&A endpoints
# For LM Studio, set LLM_PROVIDER=lm-studio, LLM_STUDIO_URL and LM_STUDIO_API_KEY / LLM_API_KEY
# For OpenAI, set LLM_PROVIDER=openai-compatible, LLM_OAI_COMPATIBLE_URL and LLM_OAI_API_KEY
LLM_ENABLED=false

# Provider: "lm-studio" or "openai-compatible"
LLM_PROVIDER=lm-studio

# LM Studio URL for chat completions
LLM_STUDIO_URL=http://host.docker.internal:1234/v1

# OpenAI-compatible chat endpoint
LLM_OAI_COMPATIBLE_URL=https://api.openai.com/v1
LLM_OAI_API_KEY=sk-your-openai-key-here

# LLM model name (e.g. "qwen3:8b", "gpt-4o-mini")
LLM_MODEL=qwen3:8b

# ─── Backpressure kit (slow local models, e.g. LM Studio over LAN) ──
# Per-attempt timeouts (secs) — fail fast, then back off with jitter.
# Longer timeouts avoid piling requests into the model server's queue.
EMBED_TIMEOUT_SECS=300
LLM_TIMEOUT_SECS=600
CHROMA_TIMEOUT_SECS=120
# Retries after the first attempt (429/5xx + transport errors only; 4xx never retried)
EMBED_MAX_RETRIES=2
LLM_MAX_RETRIES=2
# Concurrency caps — bursts queue in-process (cheap), not in the model server (expensive)
EMBED_MAX_INFLIGHT=4
LLM_MAX_INFLIGHT=2
