# Vectorizer Configuration
# Copy to .env and adjust values

# Server port
PORT=8091
GRPC_PORT=50051

# API key for authentication (optional, set to "" to disable)
DEFAULT_API_KEY=your-secret-api-key-here
# JWT auth : set AUTH_USE_AUTH=true and AUTH_JWT_SECRET to enable workspace-scoped JWT
# AUTH_USE_AUTH=false
# AUTH_JWT_SECRET=

# ChromaDB connection
CHROMA_HOST=localhost
CHROMA_PORT=8100
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# Embedding provider: "lm-studio" or "openai-compatible"
# For Qwen3-Embedding-4B 1536d (default,  parity), use openai-compatible with vLLM TEI
EMBED_PROVIDER=openai-compatible
EMBED_DIMENSIONS=1536

# LM Studio (local) - for embeddings & LLM when using LM Studio
LM_STUDIO_URL=http://host.docker.internal:1234/v1
LM_STUDIO_API_KEY=lm-studio
LLM_API_KEY=lm-studio

# OpenAI-compatible embedding endpoint (vLLM TEI for Qwen3)
OAI_COMPATIBLE_URL=http://host.docker.internal:1234/v1
OAI_API_KEY=lm-studio
# For CPU dev without GPU, override to: EMBED_MODEL=nomic-embed-text, EMBED_DIMENSIONS=768, OAI_COMPATIBLE_URL=http://localhost:1234/v1

# Embedding model name - Qwen3-Embedding-4B at 1536d via MRL (1536d)
EMBED_MODEL=Qwen/Qwen3-Embedding-4B

# For Qwen self-host via vLLM (optional)
# HF_TOKEN=hf_...
# QWEN_PORT=8001

# TTL auto-cleanup (0=disabled)
# TTL_HOURS=0

# ─── LLM Brain (optional) ──────────────────────────────
# Set LLM_ENABLED=true to enable summarization & Q&A endpoints
# For LM Studio, set LLM_PROVIDER=lm-studio, LLM_STUDIO_URL and LM_STUDIO_API_KEY / LLM_API_KEY
# For OpenAI, set LLM_PROVIDER=openai-compatible, LLM_OAI_COMPATIBLE_URL and LLM_OAI_API_KEY
LLM_ENABLED=false

# Provider: "lm-studio" or "openai-compatible"
LLM_PROVIDER=lm-studio

# LM Studio URL for chat completions
LLM_STUDIO_URL=http://host.docker.internal:1234/v1

# OpenAI-compatible chat endpoint
LLM_OAI_COMPATIBLE_URL=https://api.openai.com/v1
LLM_OAI_API_KEY=sk-your-openai-key-here

# LLM model name (e.g. "qwen3:8b", "gpt-4o-mini")
LLM_MODEL=qwen3:8b
