# Compatible layered config: env > .env > config.toml > defaults
# Copy to config.toml and edit. See docs/BLUEPRINT.md §6.

[app]
port = 8091

[db]
host = "localhost"
port = 8100

[auth]
use_auth = false
jwt_secret = ""   # set AUTH_JWT_SECRET or here
api_key = ""      # DEFAULT_API_KEY

[embedding]
provider = "openai-compatible"   # lm-studio | openai-compatible (Qwen via vLLM)
model = "text-embedding-nomic-embed-text-v2"  # 768d canonical default (opt-in: Qwen/Qwen3-Embedding-4B at 1536d via MRL)
dimensions = 768
url = "http://localhost:1234/v1"  # LM Studio default; vLLM TEI opt-in http://localhost:8001/v1

[llm]
enabled = false
provider = "lm-studio"
model = "qwen3:8b"

[grpc]
port = 50051

# Vault writeback (env-only, no TOML section — must be a conscious choice):
# VAULT_WRITEBACK=true               # default false; mirror turns to 10-memory/sessions/
# VAULT_WRITEBACK_WORKSPACES=""      # CSV allowlist, empty = all
